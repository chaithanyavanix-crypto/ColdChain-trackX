# ==============================================================================
# TracX Cold-Chain Platform - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES. DO NOT COMMIT .env TO GIT!
# ==============================================================================

# Database Configuration (PostgreSQL 16 or SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracx_fleet
# Fallback to local SQLite if PostgreSQL is unavailable:
# SQLITE_FALLBACK_PATH=backend/tracx_fleet.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development

# Frontend & CORS
FRONTEND_ORIGIN=*
# Optional: Public Tunnel or Domain URL for Vercel/IoT Firmware integration
PUBLIC_TUNNEL_URL=https://your-tunnel-subdomain.trycloudflare.com
